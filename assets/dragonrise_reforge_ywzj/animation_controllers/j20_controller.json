{
    "name": "j20_controller",
    "script": "dragonrise_reforge_ywzj:j20",
    "parameters": {},
    "switchable_animations": {
        "weapon_bay": {
            "part_id": "weapon_bay",
            "animation": "weapon_bay"
        },
        "landing_gear": {
            "part_id": "landing_gear",
            "animation": "landing_gear"
        }
    },
    "state_machines": {
        "afterburner": {
            "start_state": "init",
            "states": {
                "init": {
                    "on_enter": [
                        {
                            "type": "play_animation",
                            "animation": "afterburner_on",
                            "play_type": "play_once_hold",
                            "track": "afterburner_on"
                        },
                        {
                            "type": "play_animation",
                            "animation": "afterburner_loop",
                            "play_type": "loop",
                            "track": "afterburner_loop"
                        },
                        {
                            "type": "play_animation",
                            "animation": "afterburner_off",
                            "play_type": "play_once_hold",
                            "track": "afterburner_off"
                        }
                    ],
                    "transitions": [
                        {
                            "target": "afterburner_on",
                            "condition": {
                                "type": "script",
                                "script": "context.getPower() > 0 && context.getThrottleLevel() > 100"
                            },
                            "duration": 0.5
                        }
                    ],
                    "evaluate": {
                        "type": "track",
                        "track": ""
                    }
                },
                "afterburner_on": {
                    "transitions": [
                        {
                            "target": "afterburner_loop",
                            "condition": {
                                "type": "script",
                                "script": "context.getThrottleLevel() > 100"
                            },
                            "duration": 0.5
                        }
                    ],
                    "evaluate": {
                        "type": "track",
                        "track": "afterburner_on"
                    }
                },
                "afterburner_loop": {
                    "transitions": [
                        {
                            "target": "afterburner_off",
                            "condition": {
                                "type": "script",
                                "script": "context.getThrottleLevel() <= 100"
                            },
                            "duration": 0.5
                        }
                    ],
                    "evaluate": {
                        "type": "track",
                        "track": "afterburner_loop"
                    }
                },
                "afterburner_off": {
                    "transitions": [
                        {
                            "target": "afterburner_on",
                            "condition": {
                                "type": "script",
                                "script": "context.getPower() > 0 && context.getThrottleLevel() > 100"
                            },
                            "duration": 0.5
                        }
                    ],
                    "evaluate": {
                        "type": "track",
                        "track": "afterburner_off"
                    },
                    "duration": 0.5
                }
            }
        }
    },
    "graph": {
        "type": "merge",
        "inputs": [
            {
                "type": "state_machine",
                "ref": "afterburner"
            },
            {
                "type": "switchable_animation",
                "ref": "weapon_bay"
            },
            {
                "type": "switchable_animation",
                "ref": "landing_gear"
            },
            {
                "type": "script",
                "function": "updateBones"
            }
        ]
    }
}
